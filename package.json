    "concurrently": "^9.2.1",
    "express": "^5.2.1",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.22.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "vite": "^5.4.11",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
